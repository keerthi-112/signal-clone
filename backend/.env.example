# Copy to .env to override defaults (all optional).
DATABASE_URL=sqlite:///./signal.db
# Hosted libSQL (Turso) database; when set, used instead of DATABASE_URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:3000
MOCK_OTP_CODE=123456
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=25
SEED_ON_STARTUP=true
